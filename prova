CREATE TABLE dimensao(
id_dimensao SERIAL PRIMARY KEY NOT NULL,
nome varchar(20) NOT NULL
);

CREATE TABLE registro_vida(
id_vida SERIAL PRIMARY KEY NOT NULL,
nome varchar(50) NOT NULL,
omega numeric NOT NULL,
dimensao_id INT,
    FOREIGN KEY (dimensao_id) REFERENCES dimensao(id_dimensao)
);

